# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_ganti_dengan_token_dari_BotFather
# ID admin (dari @userinfobot). Pisahkan dengan koma jika lebih dari satu.
ADMIN_IDS=123456789

# ── Pakasir ──────────────────────────────────────────────
PAKASIR_BASE_URL=https://app.pakasir.com
PAKASIR_PROJECT=slug-project-kamu
PAKASIR_API_KEY=api-key-dari-dashboard-pakasir

# ── Webhook server (menerima callback pembayaran dari Pakasir) ──
# Path rahasia — daftarkan URL lengkapnya di dashboard Pakasir:
#   https://domain-kamu.com/pakasir/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
PAKASIR_WEBHOOK_PATH=/pakasir/webhook
# URL publik VPS kamu (untuk menyusun link pembayaran hosted)
PUBLIC_BASE_URL=https://domain-kamu.com

# ── Lain-lain ────────────────────────────────────────────
ORDER_EXPIRY_MINUTES=15
DB_PATH=bot.db

# ── Opsional: channel Telegram ───────────────────────────
# Notifikasi "Penjualan Baru" dikirim ke sini tiap ada order terbayar.
# Isi @username channel atau chat id (mis. -1001234567890).
# Bot WAJIB dijadikan admin di channel ini. Kosongkan untuk mematikan fitur ini.
SALES_CHANNEL_ID=

# Pengguna wajib join channel ini dulu sebelum bisa pakai bot (/start, /produk, beli, dst).
# Isi @username (channel publik) ATAU id numerik seperti -1001234567890 (channel privat).
# Bot WAJIB dijadikan admin di channel ini. Kosongkan untuk mematikan fitur ini.
REQUIRED_CHANNEL=
# Wajib diisi kalau REQUIRED_CHANNEL di atas berupa id numerik (channel privat):
# link invite channel-nya, mis. https://t.me/+xxxxxxxxxxxx
# Boleh dikosongkan kalau REQUIRED_CHANNEL sudah @username publik.
REQUIRED_CHANNEL_URL=
